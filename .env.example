# ===== Plantilla de variables de entorno - ticsystem =====
# Copia este archivo como .env y ajusta los valores.
# NUNCA commitear el .env real (esta en .gitignore).

# Motor de base de datos: PostgreSQL
# Formato: postgres://USUARIO:PASSWORD@HOST:PORT/NAME
# Para Docker, el host debe ser 'db' y no 'localhost'
DATABASE_URL=postgres://ticsystem_admin:una_contraseña_muy_segura@db:5432/ticsystem_db

# Clave secreta de Django (genera una nueva con: python -c "import secrets;print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=django-insecure-CAMBIA-ESTO

# Entorno: local | development | testing | production
DJANGO_ENV=production

# Opciones de seguridad para red interna (sin certificado SSL)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Credenciales individuales para que Docker levante la BD
DB_NAME=ticsystem_db
DB_USER=ticsystem_admin
DB_PASSWORD=una_contraseña_muy_segura

# Hosts permitidos
ALLOWED_HOSTS=localhost,127.0.0.1,157.245.131.99,web,ticsystem_web
